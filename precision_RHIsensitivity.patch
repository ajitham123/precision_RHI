+function frac_bar(x, frac, y, c)
+%FRAC_BAR  Bottom strip of Fig. 9: in how many noise realisations the switch
+%          occurred. Filled square = all of them, hollow = some, cross = none.
+for i = 1:numel(x)
+    if frac(i) == 1
+        plot(x(i), y, 's', 'markersize', 5, 'markerfacecolor', c(2,:), ...
+             'markeredgecolor', c(2,:), 'handlevisibility', 'off');
+    elseif frac(i) > 0
+        plot(x(i), y, 's', 'markersize', 5, 'markerfacecolor', 'none', ...
+             'markeredgecolor', c(2,:), 'handlevisibility', 'off');
+    else
+        plot(x(i), y, 'x', 'markersize', 5, 'color', [0.5 0.5 0.5], ...
+             'handlevisibility', 'off');
