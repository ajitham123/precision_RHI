+function h = band(x, mu, sg, col)
+%BAND  Shaded +/-1 s.d. ribbon, broken wherever mu is NaN (Fig. 9).
+%   Returns a handle to the first patch so it can be named in a legend.
+h  = [];
+ok = ~isnan(mu) & ~isnan(sg);
+i  = 1;
+while i <= numel(ok)
+    if ~ok(i), i = i + 1; continue, end
+    j = i;
+    while j < numel(ok) && ok(j+1), j = j + 1; end
+    if j > i
+        xx = x(i:j);  m = mu(i:j);  s = sg(i:j);
+        p = fill([xx fliplr(xx)], [m+s fliplr(m-s)], col, 'facealpha', 0.2, ...
+                 'edgecolor', 'none', 'handlevisibility', 'off');
+        if isempty(h), h = p; end
+    end
+    i = j + 1;
+end
+if isempty(h)                      % nothing to shade: keep a legend handle
+    h = fill(NaN, NaN, col, 'facealpha', 0.2, 'edgecolor', 'none', ...
+             'handlevisibility', 'off');
+end
+end
